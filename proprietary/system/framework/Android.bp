// Android 10 MTK IMS donor boot jars.
//
// These must be Soong `dex_import` modules: build/make/core/prebuilt_internal.mk
// rejects Android.mk JAVA_LIBRARIES prebuilts listed in PRODUCT_BOOT_JARS with
// "Modules in PRODUCT_BOOT_JARS must be defined in Android.bp files".
//
// This Android.bp lives next to the jar blobs so no source path escapes the
// module directory (Soong rejects parent-directory source paths). The directory inherits the
// vendor/oppo/CPH1909 soong_namespace registered by CPH1909-vendor.mk, so the
// plain module names below resolve in PRODUCT_PACKAGES and PRODUCT_BOOT_JARS.

dex_import {
    name: "mediatek-common",
    owner: "oppo",
    jars: ["mediatek-common.jar"],
}

dex_import {
    name: "mediatek-ims-base",
    owner: "oppo",
    jars: ["mediatek-ims-base.jar"],
}

dex_import {
    name: "mediatek-ims-common",
    owner: "oppo",
    jars: ["mediatek-ims-common.jar"],
}
