on post-fs-data
    mkdir /data/aee_exp 0755 root root
    mkdir /data/vendor/mtklog 0755 root root
    mkdir /data/vendor/mtklog/aee_exp 0755 root root
    mkdir /data/dumpsys 0775 system system
    mkdir /data/vendor/dumpsys 0775 system system
    mkdir /data/core 0775 system system
    mkdir /data/vendor/core 0775 system system
    mkdir /data/vendor/tombstones 0775 system system
    mkdir /data/misc/aee_interim 0755 system system

# Android 10: aee_aed / aee_aed64 do not exist in this vendor image (the only
# AEE binaries are aee_aedv, aee_aedv64, aeev, aee_archivev, aee_dumpstatev and
# aee_core_forwarder). Starting them was a silent no-op; dropped.
on post-fs
    start aee_aedv
    start aee_aedv64

on property:vold.decrypt=trigger_load_persist_props
    restart aee_aedv
    restart aee_aedv64

on property:debug.mtk.aee.reinit=done
    restart aee_aedv
    restart aee_aedv64

on property:ro.build.type=eng
    write /proc/sys/fs/suid_dumpable 1
    write /proc/sys/kernel/core_pattern "|/vendor/bin/aee_core_forwarder /data/vendor/core/ %p %s UID=%u GID=%g"

on property:ro.build.type=userdebug
    write /proc/sys/fs/suid_dumpable 1
    write /proc/sys/kernel/core_pattern "|/vendor/bin/aee_core_forwarder /data/vendor/core/ %p %s UID=%u GID=%g"

on property:persist.aee.core.dump=enable
    write /proc/sys/fs/suid_dumpable 1
    write /proc/sys/kernel/core_pattern "|/vendor/bin/aee_core_forwarder /data/vendor/core/ %p %s UID=%u GID=%g"

on init
    export LD_PRELOAD libdirect-coredump.so
    write /proc/self/coredump_filter 39
    # The ro.aee.* sets below are NOT Android-8 leftovers. The properties exist
    # in no .prop file, so property_service's PropertySet() finds nothing and
    # takes the __system_property_add() branch, creating them write-once --
    # which is what AEE wants. (Only an already-set ro.* is rejected with
    # PROP_ERROR_READ_ONLY_PROPERTY, which is not the case here.)
    setprop ro.aee.enperf off
    setprop ro.aee.enforcing yes
    setprop persist.mtk.aee.filter 0
    setprop persist.anr.dumpthr 1

on property:sys.boot_completed=1
    start aee-reinit
    start aeev-reinit
