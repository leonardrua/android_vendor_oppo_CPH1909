// Android 10 MTK IMS donor boot jars.
//
// These must be Soong `dex_import` modules: build/make/core/prebuilt_internal.mk
// rejects Android.mk JAVA_LIBRARIES prebuilts listed in PRODUCT_BOOT_JARS with
// "Modules in PRODUCT_BOOT_JARS must be defined in Android.bp files".
//
// This directory inherits the vendor/oppo/CPH1909 soong_namespace registered by
// CPH1909-vendor.mk, so the plain module names below resolve in
// PRODUCT_PACKAGES and PRODUCT_BOOT_JARS.
//
// jars are relative to this Android.bp; the files themselves are the donor
// blobs under ../proprietary/system/framework/.

dex_import {
    name: "mediatek-common",
    owner: "oppo",
    jars: ["../proprietary/system/framework/mediatek-common.jar"],
}

dex_import {
    name: "mediatek-ims-base",
    owner: "oppo",
    jars: ["../proprietary/system/framework/mediatek-ims-base.jar"],
}

dex_import {
    name: "mediatek-ims-common",
    owner: "oppo",
    jars: ["../proprietary/system/framework/mediatek-ims-common.jar"],
}
